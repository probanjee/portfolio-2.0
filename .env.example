# Copy this file to .env for local email delivery, and add the same variables in Vercel Project Settings -> Environment Variables.

# Option 1 (Primary server-side): Resend API
RESEND_API_KEY=re_your_resend_api_key
EMAIL_TO=prosunbanerjee8@gmail.com
# Optional once you verify your own domain in Resend:
# RESEND_FROM=contact@yourdomain.com

# Option 2 (Browser fallback if /api/contact is unavailable): Web3Forms
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Option 3 (Optional server SMTP fallback): Gmail with 16-character App Password
# EMAIL_USER=prosunbanerjee8@gmail.com
# EMAIL_PASS=your-16-char-gmail-app-password

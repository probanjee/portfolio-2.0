# Copy this file to .env for local email delivery, and add the same variables in Vercel Project Settings -> Environment Variables.
# Security: NEVER prefix API keys or passwords with VITE_ (Vite embeds VITE_* variables in public browser JS).

# Option 1 (Primary server-side): Resend API
RESEND_API_KEY=re_your_resend_api_key
EMAIL_TO=example@mail.com
# Optional once you verify your own domain in Resend:
# RESEND_FROM=contact@yourdomain.com

# Option 2 (Optional server SMTP fallback): Gmail with 16-character App Password
   EMAIL_USER=example@mail.com
 EMAIL_PASS=your-16-char-gmail-app-password
